# Copy this file to .env.local and fill in your Supabase values
# Get these from: https://supabase.com/dashboard → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# "dev" for local development and Vercel Preview; leave unset (= public) in Production
VITE_SUPABASE_SCHEMA=dev

# Web Push: public half of the VAPID key pair (npx web-push generate-vapid-keys).
# The private half goes into GitHub secrets only.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
